# Server
# Flask will typically bind to 127.0.0.1:5000 by default; our integration expects backend on 3001.
PORT=3001
HOST=0.0.0.0

# Primary database connection string (recommended)
# Matches the database startup defaults from the database container.
# DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp
DATABASE_URL=

# Alternatively, specify individual Postgres parameters (used if DATABASE_URL is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=5000
POSTGRES_DB=myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123

# CORS configuration
# Comma-separated list of frontend origins allowed to call this API with credentials.
# For local dev with CRA:
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cookies / Session
# Whether to mark cookies as Secure (requires HTTPS). Set to true in production behind HTTPS.
COOKIE_SECURE=false
# Cookie SameSite policy (Lax recommended for this app).
COOKIE_SAMESITE=Lax
# Cookie max-age in seconds (7 days default)
COOKIE_MAX_AGE=604800
